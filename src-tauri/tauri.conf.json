{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "spve_app",
  "version": "0.1.0",
  "identifier": "com.spve-app.app",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SPVE x Kelfoncier",
        "width": 1280,
        "height": 800,
        "minHeight": 400,
        "minWidth": 700,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
        "resources/scripts/find.py",
        "resources/scripts/generation.py"
    ]
  }
}
